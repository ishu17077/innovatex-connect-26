# Next.js App Environment Configuration
SITE_URL="https://www.connect.innovatexcom.xyz/"

# Database Configuration
MONGODB_URI="your_mongodb_connection_uri"

# Security Configuration
JWT_SECRET="your_jwt_secret_key"

# Cloudinary (if used for assets)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Email Configuration (Nodemailer)
EMAIL_USER="your_email_user@gmail.com"
EMAIL_PASS="your_email_app_password"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"

# Public Ticket Settings
NEXT_PUBLIC_TICKET_AVAILABLE=true
NEXT_PUBLIC_TICKET_REDIRECT_URL="https://innovatexcom.xyz"